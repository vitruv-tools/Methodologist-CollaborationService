# Environment variables read by the collaboration server.
# They are read from the process environment; set them in your shell, in Docker (-e) or in docker-compose.

# Port for HTTP (GET /health) and WebSocket connections
PORT=1234

# Base URL of the backend: asked for a user's role in a project, and called with the service account
BACKEND_URL=http://localhost:9811

# Keycloak, where the server gets the token of its own service account (client credentials grant).
# KEYCLOAK_URL and KEYCLOAK_CLIENT_SECRET are required: the server doesn't start without them.
KEYCLOAK_URL=http://localhost:7668
KEYCLOAK_REALM=methodologist
KEYCLOAK_CLIENT_ID=collaboration-service
# Secret of the collaboration-service client. The backend's local realm template uses this one.
KEYCLOAK_CLIENT_SECRET=dev-only-collaboration-service-secret
